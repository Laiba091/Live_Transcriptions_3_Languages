# Copy this file to ".env" and change values if needed. All are optional.

# Pashto model (Hugging Face id or local folder)
PASHTO_MODEL=uzair0/Katib-ASR

# English + Urdu model: large-v3 (best, GPU) | large-v3-turbo (faster) | medium
# WHISPER_MODEL=large-v3

# Pause (ms) that ends a sentence. Raise if sentences get cut in the middle.
MIN_SILENCE_MS=600

# Below this confidence the previous speaker's language is kept.
LID_MIN_CONFIDENCE=0.60

# Raise in a noisy room (0.5 - 0.8)
VAD_THRESHOLD=0.5

# Where JSON / Excel files are saved
# DATA_DIR=data/sessions

PORT=8000
